<mxCell id="note0" value="&lt;b style=&quot;font-size:17px&quot;&gt;每个实体每步更新一次&lt;/b&gt;&lt;div style=&quot;padding-top:9px;line-height:1.55;font-size:15px&quot;&gt;地图先根据玩家位置准备邻近地形，再由 Entities 按稳定 ID 顺序推进实体。注册表只是玩家索引；新增、移除和恢复实体时同步更新两个索引。命中或移除在遍历结束后结算。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=12;align=left;verticalAlign=top;fillColor=#FAF6EB;strokeColor=#D7C8A3;fontColor=#494336;fontSize=15;html=1" vertex="1" parent="1"><mxGeometry x="36" y="913" width="443" height="190" as="geometry"/></mxCell>
<mxCell id="note1" value="&lt;b style=&quot;font-size:17px&quot;&gt;画面顺序独立于 tick&lt;/b&gt;&lt;div style=&quot;padding-top:9px;line-height:1.55;font-size:15px&quot;&gt;getSnapshot 按 Background → GameMap → Entities → Filter 收集，实体按脚底 y、再按 id 排序。跟随本地玩家计算相机原点，将世界坐标转换为面板坐标后发布。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=12;align=left;verticalAlign=top;fillColor=#FAF6EB;strokeColor=#D7C8A3;fontColor=#494336;fontSize=15;html=1" vertex="1" parent="1"><mxGeometry x="546" y="913" width="443" height="190" as="geometry"/></mxCell>
<mxCell id="note2" value="&lt;b style=&quot;font-size:17px&quot;&gt;地图读写&lt;/b&gt;&lt;div style=&quot;padding-top:9px;line-height:1.55;font-size:15px&quot;&gt;canEnter 在目的地查询地形，分轴处理碰撞。越过缓存边界时按 seed 补齐目标格。改动地形单独存储并覆盖生成结果；缓存用具备值相等语义的格坐标，避免用 int[] 作集合键。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=12;align=left;verticalAlign=top;fillColor=#FAF6EB;strokeColor=#D7C8A3;fontColor=#494336;fontSize=15;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="913" width="443" height="190" as="geometry"/></mxCell>
<mxCell id="legend" value="蓝绿框为已有类型，绿框为新增类型，紫框为已有接口。实线空三角为继承，虚线空三角为实现，虚线箭头为依赖，实心菱形为组合。方法列显示目标契约。" style="text;align=left;strokeColor=none;fillColor=none;fontSize=13;fontColor=#4B6570;html=1" vertex="1" parent="1"><mxGeometry x="36" y="1125" width="1463" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="architecture-4" name="04 角色与动作"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1535" pageHeight="1407"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="用一个状态机决定角色这一帧做什么" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#123847;html=1" vertex="1" parent="1"><mxGeometry x="36" y="24" width="1463" height="40" as="geometry"/></mxCell>
<mxCell id="desc" value="移动、朝向、一次性动作和可叠加状态分别表达。每个实体独立保存游戏步计数。" style="text;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#3D5966;html=1" vertex="1" parent="1"><mxGeometry x="36" y="71" width="1463" height="28" as="geometry"/></mxCell>
<mxCell id="player" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 接收领域命令&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;Player&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ handleCommand(type: CommandType): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ clearInput(): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="116" width="443" height="130" as="geometry"/></mxCell>
<mxCell id="entity" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有抽象类 · 组合状态机&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;Entity&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− stateManager: EntityStateMachine&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− stats: EntityStats&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ tick(w: World): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ visualItem(): RenderableItem&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ takeDamage(amount: int): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="546" y="116" width="443" height="209" as="geometry"/></mxCell>
<mxCell id="body" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有抽象类 · 坐标与碰撞&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;PhysicsBody&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− x, y: double&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ tryMove(dx: double, dy: double, map: GameMap): boolean&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="116" width="443" height="140" as="geometry"/></mxCell>
<mxCell id="move" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有抽象类 → 枚举&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;MovementState&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;IDLE, WALK, RUN&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="390" width="443" height="107" as="geometry"/></mxCell>
<mxCell id="sm" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 改为领域状态&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;EntityStateMachine&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− movement: MovementState = IDLE&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− facing: Facing = DOWN&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− action: ActionState = NONE&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− elapsedTicks: int&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− statuses: Set&amp;lt;StatusState&amp;gt;&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ accept(type: CommandType): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ clearInput(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ addStatus(effect: StatusState): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ tick(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ dx(): double&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ dy(): double&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ afterMove(moved: boolean): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ attackHitsNow(): boolean&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ consumeInteract(): boolean&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ animationKey(spriteId: String): AnimationKey&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ elapsedTicks(): int&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="546" y="390" width="443" height="462" as="geometry"/></mxCell>
<mxCell id="status" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有抽象类 · 每个效果独立计时&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;StatusState&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− remainingTicks: int&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ tick(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ blocksMovement(): boolean&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ expired(): boolean&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="390" width="443" height="186" as="geometry"/></mxCell>
<mxCell id="f" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;新增枚举&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;Facing&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #66A287;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;UP, DOWN, LEFT, RIGHT&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E7F5EE;strokeColor=#66A287;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="917" width="443" height="107" as="geometry"/></mxCell>
<mxCell id="act" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;新增枚举&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;ActionState&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #66A287;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;NONE, ATTACK&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E7F5EE;strokeColor=#66A287;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="546" y="917" width="443" height="107" as="geometry"/></mxCell>
<mxCell id="cmd" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 命令枚举与映射&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;LocalPlayerCommand&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− command: CommandType&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ LocalPlayerCommand(command: String)&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ getCommand(): CommandType&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="917" width="443" height="163" as="geometry"/></mxCell>
