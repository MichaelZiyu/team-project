<mxCell id="init" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有接口&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;InitializeWorldBoundary&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8A8EB7;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ initialize(data: InitializeGameData): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#EEF0FA;strokeColor=#8A8EB7;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="449" width="443" height="107" as="geometry"/></mxCell>
<mxCell id="load" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有接口 · 调整存档类型&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;LoadGameBoundary&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8A8EB7;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ loadGame(filename: String): WorldState&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ saveGame(filename: String, state: WorldState): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#EEF0FA;strokeColor=#8A8EB7;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="884" width="443" height="130" as="geometry"/></mxCell>
<mxCell id="sync" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有接口 · 增加导出&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;GameSynchronizationBoundary&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8A8EB7;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ synchronize(state: WorldState): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ captureState(): WorldState&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#EEF0FA;strokeColor=#8A8EB7;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="546" y="884" width="443" height="130" as="geometry"/></mxCell>
<mxCell id="dto" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 扩充为数据快照&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;WorldState&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;seed, simulationTick, localPlayerId&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;玩家、实体、背包、动作计数与地形修改&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ seed(): long&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ simulationTick(): long&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ localPlayerId(): String&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="884" width="443" height="209" as="geometry"/></mxCell>
<mxCell id="edge0" edge="1" parent="1" source="w" target="cmd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;endArrow=block;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge1" edge="1" parent="1" source="w" target="tick" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;endArrow=block;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge2" edge="1" parent="1" source="w" target="snap" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;dashed=1;endArrow=block;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge3" edge="1" parent="1" source="w" target="sync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;endArrow=block;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge4" edge="1" parent="1" source="w" target="init" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;endArrow=block;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge5" edge="1" parent="1" source="sync" target="dto" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;endArrow=open;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge6" edge="1" parent="1" source="controller" target="cmd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;endArrow=open;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge7" edge="1" parent="1" source="controller" target="tick" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;endArrow=open;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note0" value="&lt;b style=&quot;font-size:17px&quot;&gt;游戏线程的一步&lt;/b&gt;&lt;div style=&quot;padding-top:9px;line-height:1.55;font-size:15px&quot;&gt;先处理会话请求，再应用有效的远端数据（如果有），消费输入，执行 World.tick()，最后将 getSnapshot() 交给 submitSnapshot()。沿用 GameSettings.FPS 的固定步长；丢弃旧画面不影响模拟。 translateLocalCommand 对未知键返回 CommandType.NULL，控制器丢弃。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=12;align=left;verticalAlign=top;fillColor=#FAF6EB;strokeColor=#D7C8A3;fontColor=#494336;fontSize=15;html=1" vertex="1" parent="1"><mxGeometry x="36" y="1143" width="443" height="190" as="geometry"/></mxCell>
<mxCell id="note1" value="&lt;b style=&quot;font-size:17px&quot;&gt;新建、读档与保存&lt;/b&gt;&lt;div style=&quot;padding-top:9px;line-height:1.55;font-size:15px&quot;&gt;新建调用 initialize；读档由 LoadGameBoundary 的文件适配器读出完整 WorldState，再用 synchronize 一次性重建世界。保存时在帧边界 captureState，写入临时文件成功后替换目标。图像和 Swing 组件不进入存档。 控制器持有文件适配器。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=12;align=left;verticalAlign=top;fillColor=#FAF6EB;strokeColor=#D7C8A3;fontColor=#494336;fontSize=15;html=1" vertex="1" parent="1"><mxGeometry x="546" y="1143" width="443" height="190" as="geometry"/></mxCell>
<mxCell id="note2" value="&lt;b style=&quot;font-size:17px&quot;&gt;本地与远端&lt;/b&gt;&lt;div style=&quot;padding-top:9px;line-height:1.55;font-size:15px&quot;&gt;本地命令走 localPlayerId；远端命令携带 playerId 和序号，按注册表找到同一个 Player 对象，忽略过期或未知玩家命令。单机直接跳过同步；联网若采用全量快照，按模拟步序号拒绝过期包。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=12;align=left;verticalAlign=top;fillColor=#FAF6EB;strokeColor=#D7C8A3;fontColor=#494336;fontSize=15;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="1143" width="443" height="190" as="geometry"/></mxCell>
<mxCell id="legend" value="蓝绿框为已有类型，绿框为新增类型，紫框为已有接口。实线空三角为继承，虚线空三角为实现，虚线箭头为依赖，实心菱形为组合。方法列显示目标契约。" style="text;align=left;strokeColor=none;fillColor=none;fontSize=13;fontColor=#4B6570;html=1" vertex="1" parent="1"><mxGeometry x="36" y="1355" width="1463" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="architecture-3" name="03 场景与世界模型"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1535" pageHeight="1190"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="谁推进世界，谁决定绘制顺序" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#123847;html=1" vertex="1" parent="1"><mxGeometry x="36" y="24" width="1463" height="40" as="geometry"/></mxCell>
<mxCell id="desc" value="World 确定模拟顺序；各 Scene 提供可见项。相机坐标在组装快照时统一换算。" style="text;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#3D5966;html=1" vertex="1" parent="1"><mxGeometry x="36" y="71" width="1463" height="28" as="geometry"/></mxCell>
<mxCell id="bg" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 静态场景&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;Background&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ appendItems(w: World, out: List&amp;lt;RenderableItem&amp;gt;): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="116" width="443" height="107" as="geometry"/></mxCell>
<mxCell id="s" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有抽象类 · 扩展&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;Scene&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ tick(w: World): void  {默认空实现}&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ appendItems(w: World, out: List&amp;lt;RenderableItem&amp;gt;): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="546" y="116" width="443" height="130" as="geometry"/></mxCell>
<mxCell id="fl" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 最后绘制的叠加层&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;Filter&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ appendItems(w: World, out: List&amp;lt;RenderableItem&amp;gt;): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="116" width="443" height="107" as="geometry"/></mxCell>
<mxCell id="map" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 地形及场景交互&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;GameMap&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− terrain: ChunckedTerrain&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ tick(w: World): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ canEnter(x: double, y: double): boolean&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ interact(p: Player): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ appendItems(w: World, out: List&amp;lt;RenderableItem&amp;gt;): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="311" width="443" height="209" as="geometry"/></mxCell>
<mxCell id="w" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 世界聚合&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;World&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− gameMap: GameMap&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− entities: Entities&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− sceneList: List&amp;lt;Scene&amp;gt;&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ tick(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ getSnapshot(): RenderableData&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ getMap(): GameMap&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ getPlayer(): Player&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ resolveAttack(source: Entity): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="546" y="311" width="443" height="278" as="geometry"/></mxCell>
<mxCell id="es" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 实体集合&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;Entities&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− members: Map&amp;lt;String, Entity&amp;gt;&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ add(e: Entity): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ remove(id: String): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ tick(w: World): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ appendItems(w: World, out: List&amp;lt;RenderableItem&amp;gt;): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="311" width="443" height="209" as="geometry"/></mxCell>
