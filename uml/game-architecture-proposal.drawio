<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
<diagram id="architecture-1" name="01 会话与菜单"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1535" pageHeight="1292"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="会话的所有权与菜单边界" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#123847;html=1" vertex="1" parent="1"><mxGeometry x="36" y="24" width="1463" height="40" as="geometry"/></mxCell>
<mxCell id="desc" value="菜单通过控制接口发出请求。游戏线程在 tick 边界执行，Swing 事件线程负责切换界面。" style="text;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#3D5966;html=1" vertex="1" parent="1"><mxGeometry x="36" y="71" width="1463" height="28" as="geometry"/></mxCell>
<mxCell id="main" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 组装入口&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;Main&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ main(args: String[]): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="116" width="443" height="107" as="geometry"/></mxCell>
<mxCell id="gc" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 会话控制&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;GameController&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− phase: SessionPhase&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− worker: Thread&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− commands: Queue&amp;lt;SessionRequest&amp;gt;&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ initializeGame(data: InitializeGameData): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ pause(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ resume(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ save(filename: String): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ stop(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ run(): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="546" y="116" width="443" height="301" as="geometry"/></mxCell>
<mxCell id="in" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有接口 · 调整&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;GameControllerBoundary&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8A8EB7;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ initializeGame(data: InitializeGameData): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ pause(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ resume(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ save(filename: String): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ stop(): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#EEF0FA;strokeColor=#8A8EB7;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="116" width="443" height="199" as="geometry"/></mxCell>
<mxCell id="ib" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · EDT 写，游戏线程读&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;InputBuffer&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− heldKeys: Set&amp;lt;Integer&amp;gt;&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ keyPressed(e: KeyEvent): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ keyReleased(e: KeyEvent): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ keyTyped(e: KeyEvent): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ getInput(): Queue&amp;lt;AWTEvent&amp;gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ clear(): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="482" width="443" height="232" as="geometry"/></mxCell>
<mxCell id="ui" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有接口 · 由菜单实现&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;UICommandBoundary&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8A8EB7;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ execute(command: UICommand, listener: UIListener): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#EEF0FA;strokeColor=#8A8EB7;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="546" y="482" width="443" height="130" as="geometry"/></mxCell>
<mxCell id="cb" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 扩展回调&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;UIListener&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ onResume(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ onQuit(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ onStopped(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ onError(message: String): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="482" width="443" height="176" as="geometry"/></mxCell>
<mxCell id="phase" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;新增枚举&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;SessionPhase&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #66A287;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;MENU, STARTING, RUNNING, PAUSED, STOPPING&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E7F5EE;strokeColor=#66A287;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="779" width="443" height="107" as="geometry"/></mxCell>
<mxCell id="uiCmd" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有抽象类 · 菜单消息&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;UICommand&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;StaticUICommand.PAUSE&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;DynamicUICommand.INVENTORY&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="546" y="779" width="443" height="130" as="geometry"/></mxCell>
<mxCell id="init" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 移至 game.interactor.inputData&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;InitializeGameData&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− seed: long&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− filename: Optional&amp;lt;String&amp;gt;&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ seed(): long&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ filename(): Optional&amp;lt;String&amp;gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="779" width="443" height="186" as="geometry"/></mxCell>
<mxCell id="edge0" edge="1" parent="1" source="main" target="gc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;endArrow=open;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge1" edge="1" parent="1" source="gc" target="in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;endArrow=block;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge2" edge="1" parent="1" source="gc" target="ib" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;endArrow=open"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge3" edge="1" parent="1" source="gc" target="ui" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;endArrow=open;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge4" edge="1" parent="1" source="ui" target="cb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;endArrow=open;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge5" edge="1" parent="1" source="ui" target="uiCmd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;endArrow=open;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge6" edge="1" parent="1" source="gc" target="phase" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;dashed=1;endArrow=open;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge7" edge="1" parent="1" source="in" target="init" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;strokeWidth=1.4;strokeColor=#536F7C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;endArrow=open;endFill=0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note0" value="&lt;b style=&quot;font-size:17px&quot;&gt;启动&lt;/b&gt;&lt;div style=&quot;padding-top:9px;line-height:1.55;font-size:15px&quot;&gt;Main 在 EDT 组装同一个 InputBuffer、GamePanel、GameView 和控制器，将输入监听器绑定到游戏面板。菜单调用 initializeGame；MENU → STARTING 后只启动一个工作线程，初始化成功再进入 RUNNING。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=12;align=left;verticalAlign=top;fillColor=#FAF6EB;strokeColor=#D7C8A3;fontColor=#494336;fontSize=15;html=1" vertex="1" parent="1"><mxGeometry x="36" y="1015" width="443" height="190" as="geometry"/></mxCell>
<mxCell id="note1" value="&lt;b style=&quot;font-size:17px&quot;&gt;暂停与退出&lt;/b&gt;&lt;div style=&quot;padding-top:9px;line-height:1.55;font-size:15px&quot;&gt;暂停请求在下一步模拟之前生效。控制器清空按键及持续意图，在 EDT 执行 PAUSE。onResume / onQuit 分别转交 resume / stop。暂停时仍消费会话请求；INVENTORY 面板可保持模拟运行。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=12;align=left;verticalAlign=top;fillColor=#FAF6EB;strokeColor=#D7C8A3;fontColor=#494336;fontSize=15;html=1" vertex="1" parent="1"><mxGeometry x="546" y="1015" width="443" height="190" as="geometry"/></mxCell>
<mxCell id="note2" value="&lt;b style=&quot;font-size:17px&quot;&gt;重新进入&lt;/b&gt;&lt;div style=&quot;padding-top:9px;line-height:1.55;font-size:15px&quot;&gt;stop 在帧边界进入 STOPPING，撤销本局待显示帧并结束工作线程；随后在 EDT 发出 onStopped，菜单才允许新开局。重复开始或停止请求幂等。启动失败回到 MENU 并通知 onError。 Main 为下一局组装新的会话对象。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=12;align=left;verticalAlign=top;fillColor=#FAF6EB;strokeColor=#D7C8A3;fontColor=#494336;fontSize=15;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="1015" width="443" height="190" as="geometry"/></mxCell>
<mxCell id="legend" value="蓝绿框为已有类型，绿框为新增类型，紫框为已有接口。实线空三角为继承，虚线空三角为实现，虚线箭头为依赖，实心菱形为组合。方法列显示目标契约。" style="text;align=left;strokeColor=none;fillColor=none;fontSize=13;fontColor=#4B6570;html=1" vertex="1" parent="1"><mxGeometry x="36" y="1227" width="1463" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="architecture-2" name="02 World 与用例端口"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1535" pageHeight="1420"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="一轮模拟的入口" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#123847;html=1" vertex="1" parent="1"><mxGeometry x="36" y="24" width="1463" height="40" as="geometry"/></mxCell>
<mxCell id="desc" value="Main 将同一个 World 注入五个端口。控制器分别经端口调用；LoadGameBoundary 由独立文件适配器实现。" style="text;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#3D5966;html=1" vertex="1" parent="1"><mxGeometry x="36" y="71" width="1463" height="28" as="geometry"/></mxCell>
<mxCell id="controller" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 调度&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;GameController&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− handleCommand(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− handleLocalCommand(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− handleRemoteCommand(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− translateLocalCommand(e: AWTEvent): LocalPlayerCommand&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− synchronize(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− tick(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− render(): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="116" width="443" height="268" as="geometry"/></mxCell>
<mxCell id="tick" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有接口&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;GameTickBoundary&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8A8EB7;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ tick(): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#EEF0FA;strokeColor=#8A8EB7;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="546" y="116" width="443" height="107" as="geometry"/></mxCell>
<mxCell id="snap" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有接口&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;GameSnapshotBoundary&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8A8EB7;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ getSnapshot(): RenderableData&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#EEF0FA;strokeColor=#8A8EB7;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="116" width="443" height="107" as="geometry"/></mxCell>
<mxCell id="cmd" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有接口&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;GameCommandBoundary&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8A8EB7;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ handleLocalPlayerCommand(c: LocalPlayerCommand): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ handleRemotePlayerCommand(c: RemotePlayerCommand): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ clearInput(): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#EEF0FA;strokeColor=#8A8EB7;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="449" width="443" height="176" as="geometry"/></mxCell>
<mxCell id="w" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · 用例实现&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;World&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− entities: Entities&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− localPlayerId: String&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− playerRegistry: Map&amp;lt;String, Player&amp;gt;&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ initialize(data: InitializeGameData): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ synchronize(state: WorldState): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ captureState(): WorldState&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ handleLocalPlayerCommand(c: LocalPlayerCommand): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ handleRemotePlayerCommand(c: RemotePlayerCommand): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ tick(): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ getSnapshot(): RenderableData&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ clearInput(): void&lt;/div&gt;&lt;/div&