<mxCell id="panel" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有 · Swing 绘图区&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;GamePanel&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #68A1AB;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− snapshot: RenderableData&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− animations: AnimationLibrary&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ GamePanel(animations: AnimationLibrary)&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ setSnapshot(snapshot: RenderableData): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;# paintComponent(g: Graphics): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E5F2F5;strokeColor=#68A1AB;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="546" y="733" width="443" height="209" as="geometry"/></mxCell>
