<mxCell id="note0" value="&lt;b style=&quot;font-size:17px&quot;&gt;发布&lt;/b&gt;&lt;div style=&quot;padding-top:9px;line-height:1.55;font-size:15px&quot;&gt;World 组装完本步画面后以 List.copyOf 冻结；各项只含不可变键、计数和坐标。GameController.render 沿用 getSnapshot → submitSnapshot。GameView 继续 setSnapshot → repaint。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=12;align=left;verticalAlign=top;fillColor=#FAF6EB;strokeColor=#D7C8A3;fontColor=#494336;fontSize=15;html=1" vertex="1" parent="1"><mxGeometry x="36" y="992" width="443" height="190" as="geometry"/></mxCell>
<mxCell id="note1" value="&lt;b style=&quot;font-size:17px&quot;&gt;合并通知&lt;/b&gt;&lt;div style=&quot;padding-top:9px;line-height:1.55;font-size:15px&quot;&gt;submitSnapshot 覆盖 latest。仅第一次将 scheduled 从 false 改为 true 时投递 invokeLater。EDT 用 getAndSet(null) 取帧，更新画面，释放标志并复查 latest；若已有新帧再申请一次。每局使用独立 renderer，退出后旧任务失效。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=12;align=left;verticalAlign=top;fillColor=#FAF6EB;strokeColor=#D7C8A3;fontColor=#494336;fontSize=15;html=1" vertex="1" parent="1"><mxGeometry x="546" y="992" width="443" height="190" as="geometry"/></mxCell>
<mxCell id="note2" value="&lt;b style=&quot;font-size:17px&quot;&gt;绘制&lt;/b&gt;&lt;div style=&quot;padding-top:9px;line-height:1.55;font-size:15px&quot;&gt;paintComponent 依序访问各项，通过 resolve 找到共享的只读 Texture，再沿用 drawImage、getImage、getWidth 和 getHeight。静态地形也用同一条路径，固定动作与第 0 帧即可。&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=12;align=left;verticalAlign=top;fillColor=#FAF6EB;strokeColor=#D7C8A3;fontColor=#494336;fontSize=15;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="992" width="443" height="190" as="geometry"/></mxCell>
<mxCell id="legend" value="蓝绿框为已有类型，绿框为新增类型，紫框为已有接口。实线空三角为继承，虚线空三角为实现，虚线箭头为依赖，实心菱形为组合。方法列显示目标契约。" style="text;align=left;strokeColor=none;fillColor=none;fontSize=13;fontColor=#4B6570;html=1" vertex="1" parent="1"><mxGeometry x="36" y="1204" width="1463" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="architecture-6" name="06 贴图与动画"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1535" pageHeight="926"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="动作键如何对应实际素材" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#123847;html=1" vertex="1" parent="1"><mxGeometry x="36" y="24" width="1463" height="40" as="geometry"/></mxCell>
<mxCell id="desc" value="角色决定要表现的动作，资源表负责选择序列，AnimationClip 按该角色的 elapsedTicks 返回帧。" style="text;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#3D5966;html=1" vertex="1" parent="1"><mxGeometry x="36" y="71" width="1463" height="28" as="geometry"/></mxCell>
<mxCell id="key" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;新增 · 不可变 record&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;AnimationKey&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #66A287;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;spriteId: String, pose: String, facing: Facing&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ spriteId(): String&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ pose(): String&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ facing(): Facing&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E7F5EE;strokeColor=#66A287;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="116" width="443" height="186" as="geometry"/></mxCell>
<mxCell id="lib" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;新增 · 输出侧资源表&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;AnimationLibrary&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #66A287;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− clips: Map&amp;lt;AnimationKey, AnimationClip&amp;gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− placeholder: Texture&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ preload(loader: LoadTextureBoundary): void&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ resolve(key: AnimationKey, tick: int): Texture&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E7F5EE;strokeColor=#66A287;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="546" y="116" width="443" height="186" as="geometry"/></mxCell>
<mxCell id="port" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;已有接口 · 加载一帧&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;LoadTextureBoundary&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8A8EB7;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ loadTexture(texturePath: String, width: int, height: int): Texture&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#EEF0FA;strokeColor=#8A8EB7;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="1056" y="116" width="443" height="130" as="geometry"/></mxCell>
<mxCell id="clip" value="&lt;div style=&quot;font-size:12px;color:#425D6A&quot;&gt;新增 · 不可变序列&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;padding:4px 0 6px&quot;&gt;AnimationClip&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #66A287;padding-top:4px&quot;&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− frames: List&amp;lt;Texture&amp;gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− durations: List&amp;lt;Integer&amp;gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;− loop: boolean&lt;/div&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 0;font-family:Consolas,Microsoft YaHei,monospace;font-size:13px&quot;&gt;+ frameAt(elapsedTicks: int): Texture&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;spacing=10;verticalAlign=top;align=left;fillColor=#E7F5EE;strokeColor=#66A287;strokeWidth=1.5;fontColor=#163445;fontSize=14;html=1" vertex="1" parent="1"><mxGeometry x="36" y="367" width="443" height="186" as="geometry"/></mxCell>
